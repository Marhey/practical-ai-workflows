{
  "name": "Renewal Follow-Up Demo",
  "nodes": [
    {
      "parameters": {
        "content": "## Renewal Follow-Up Demo\nSample-data demo using fictional accounts. All data is fictional. No emails or messages are sent and no outreach happens.\n\nPurpose: identify upcoming renewals (within 90 days) and prioritize outreach - at-risk accounts (health score < 60) get High priority, others Normal.\n\n## Contact Verification\nThe LinkedIn and Google (ZoomInfo) links are research search links only. They do NOT confirm or verify any contact. Every record stays \"Pending manual review\" until a person checks it.",
        "height": 260,
        "width": 700,
        "color": 4
      },
      "name": "Demo Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        288,
        -208
      ]
    },
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { accountName: 'Acme Manufacturing', daysUntilRenewal: 45, annualValue: 24000, healthScore: 45 } },\n  { json: { accountName: 'Summit Logistics', daysUntilRenewal: 75, annualValue: 18000, healthScore: 85 } },\n  { json: { accountName: 'Harbor Services', daysUntilRenewal: 150, annualValue: 12000, healthScore: 70 } },\n];"
      },
      "name": "Sample Renewal Accounts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "due-90",
              "leftValue": "={{ $json.daysUntilRenewal }}",
              "rightValue": 90,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ]
        },
        "options": {}
      },
      "name": "Due Within 90 Days",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
      "position": [
        448,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const accountName = String(item.json.accountName || '');\n  return {\n    json: {\n      ...item.json,\n      linkedInSearchUrl: 'https://www.linkedin.com/search/results/people/?keywords=' + encodeURIComponent(accountName + ' procurement finance'),\n      zoomInfoSearchUrl: 'https://www.google.com/search?q=' + encodeURIComponent('site:zoominfo.com ' + accountName + ' procurement finance'),\n      contactVerified: false,\n      contactVerificationStatus: 'Pending manual review',\n      verificationChecklist: 'Confirm company identity, current employer, role in renewal, and contact details before outreach',\n    },\n  };\n});"
      },
      "name": "Build Contact Research Links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        224
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "requiredContactRoles",
              "value": "Renewal owner; Procurement; Finance",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "researchOnly",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "name": "Contact Verification Checklist",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        944,
